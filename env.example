# Copy to `.env` (or app user-data folder) and fill in real values.
# Windows: %APPDATA%/CommentPilot AI/.env
# macOS: ~/Library/Application Support/CommentPilot AI/.env
# Never commit real secrets.

PORT=5003
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:5003/api/auth/google/oauth-callback

# Firebase (Firestore database + Storage for .ovpn files)
# NOTE: All app data lives in this ONE primary Firestore project.
FIREBASE_PROJECT_ID=ytautomation-2fae5
FIREBASE_STORAGE_BUCKET=ytautomation-2fae5.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Multi-project Google Sign-In ─────────────────────────────────────────────
AUTH_PROJECTS=ytautomation-2fae5,ytautomation-a90e5,ytautomation-74082
AUTH_DEFAULT_PROJECT=ytautomation-2fae5
PROJECT_LABEL_YTAUTOMATION_2FAE5=Project 1 (main)

PROJECT_LABEL_YTAUTOMATION_A90E5=Project 2
OAUTH_CLIENT_ID_YTAUTOMATION_A90E5=your-project-2-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET_YTAUTOMATION_A90E5=your-project-2-oauth-client-secret

PROJECT_LABEL_YTAUTOMATION_74082=Project 3
OAUTH_CLIENT_ID_YTAUTOMATION_74082=your-project-3-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET_YTAUTOMATION_74082=your-project-3-oauth-client-secret

GEMINI_API_KEY=your-gemini-api-key
# Free-tier split: Flash-Lite for English drafts, Flash for Khasi/Pnar/Garo adaptation.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_ADAPT_MODEL=gemini-2.5-flash
GEMINI_ADAPT_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest
# YouTube Data API key (used for video details / search — create in Google Cloud Console)
YOUTUBE_API_KEY=your-youtube-data-api-key
# FIVESIM (SMS numbers for Google signup)
FIVESIM_API_KEY=your-fivesim-api-key
# country/operator "any" = auto-pick cheapest in-stock country
FIVESIM_COUNTRY=any
FIVESIM_OPERATOR=any
FIVESIM_PRODUCT=google
ENCRYPTION_KEY=32-char-secret-for-token-encryption
# Prefer a 64-char hex key, or any passphrase (hashed to AES-256). Changing this
# invalidates stored Google tokens — reconnect accounts after changing it.

# Optional VPN (OpenVPN must be installed on the machine)
VPN_USERNAME=
VPN_PASSWORD=
