# Copied/sanitized from project root .env by: npm run prepare:firebase
# Do not commit real values.
#
# Firebase rejects these keys in functions/.env (do not add them):
#   PORT, FIREBASE_*, X_GOOGLE_*, EXT_*
# Those are filled at runtime via src/config/envDefaults.js + Cloud ADC.

# Required
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=
GEMINI_API_KEY=

# Production URLs (prepare script overwrites these)
PUBLIC_BASE_URL=https://ytautomation-2fae5.web.app
OAUTH_REDIRECT_URI=https://ytautomation-2fae5.web.app/api/auth/google/oauth-callback

# Gemini
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_FALLBACKS=

# Optional
YOUTUBE_API_KEY=
FIVESIM_API_KEY=

# Multi-project Google Sign-In (optional)
AUTH_PROJECTS=
AUTH_DEFAULT_PROJECT=
