{
  "name": "yt_automation",
  "version": "1.0.0",
  "description": "CommentPilot AI — YouTube automation desktop app",
  "main": "electron/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --watch .env src/server.js",
    "electron": "electron .",
    "electron:dev": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build": "electron-builder --win --mac",
    "prepare:firebase": "node scripts/prepare-firebase-deploy.js",
    "deploy": "npm run prepare:firebase && firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "npm run prepare:firebase && firebase deploy --only functions",
    "check:firebase": "node scripts/check-firebase-credentials.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "puppeteer": "^22.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.commentpilot.ytautomation",
    "productName": "CommentPilot AI",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.png",
      "!**/__pycache__/**",
      "!browser_sessions/**",
      "!vpn_pids/**",
      "!uploads/**",
      "!dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "python_script",
        "to": "python_script",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.png"
        ]
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      },
      {
        "from": "serverListTCP",
        "to": "serverListTCP",
        "filter": [
          "**/*.ovpn"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CommentPilot AI"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
